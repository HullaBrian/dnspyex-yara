<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless harness for the dnlib-only core of the extension. See tests/run-tests.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DnSpyBin Condition=" '$(DnSpyBin)' == '' ">$(MSBuildThisFileDirectory)..\..\.tools\dnSpy\bin</DnSpyBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\dnSpy.Yara\Core\*.cs" Link="Core\%(Filename).cs" />
    <Reference Include="dnlib"><HintPath>$(DnSpyBin)\dnlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
